
# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enertwin

# Firebase (optional – token validation skipped if unset)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LLM (optional – rule-based fallback if unset)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# CORS
FRONTEND_URL=http://localhost:3000

# App
DEBUG=true
CO2_EMISSION_FACTOR_KG_PER_KWH=0.68
DEFAULT_ELECTRICITY_TARIFF=8.2
